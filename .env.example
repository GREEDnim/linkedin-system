# Reference list of every variable the services read. Copy what you need into a local .env:
#
#   cp .env.example .env        # .env is gitignored; this file is not
#   set -a; . ./.env; set +a    # exports them into the current shell
#
# docker compose reads .env from this directory automatically, for ${...} substitution.
#
# Nothing here is a secret: these are the development defaults already present in each
# application.yaml. Real deployments inject the same names from the platform's secret store,
# and the values differ.

# ── Infrastructure (docker compose) ──────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root

# ── Object storage: user-service and post-service ────────────────────────────────────────────
# Blank means "talk to real AWS". Point it at s3mock for local work; without it, uploads fail
# with an authentication error because dev-access-key is not an AWS credential.
AWS_ENDPOINT=http://localhost:9090
AWS_REGION=us-east-1
AWS_ACCESS_KEY=dev-access-key
AWS_SECRET_KEY=dev-secret-key
# Per service, so it cannot live in a shared file: user-service uses linkedin-profile-media,
# post-service uses linkedin-post-media. Each yaml already defaults to the right one.
#AWS_S3_BUCKET=

# ── MySQL: user-service (user_db) and post-service (post_db) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
# DB_NAME is per service for the same reason as the bucket: user_db or post_db.

# ── Redis: user-service (sessions), feed-service (timelines), api-gateway (rate limits) ─────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka and Elasticsearch ──────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ES_URIS=http://localhost:9200

# ── Authentication: user-service and api-gateway ─────────────────────────────────────────────
# Must be identical in both. Base64, at least 32 bytes (256 bits) or the JWT library refuses it.
# Left commented on purpose: the committed default only works under the dev profile, and that
# refusal is the point. Set a real value here before deploying anywhere.
#JWT_SECRET=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=user-service

# ── Profiles ─────────────────────────────────────────────────────────────────────────────────
# user-service and api-gateway refuse to start on the committed signing key unless this is dev.
# Anything else, including unset, is treated as a deployment.
SPRING_PROFILES_ACTIVE=dev

# ── api-gateway ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=600
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006
SERVER_ADDRESS=127.0.0.1
USER_SERVICE_URI=http://127.0.0.1:8081
POST_SERVICE_URI=http://127.0.0.1:8082
FEED_SERVICE_URI=http://127.0.0.1:8083
SEARCH_SERVICE_URI=http://127.0.0.1:8084
NOTIFICATION_SERVICE_URI=http://127.0.0.1:8085
